# =========================================================================
# CareerForge Production Environment Configuration Template
# COPY THIS FILE TO: .env.prod (DO NOT COMMIT .env.prod TO GIT)
# =========================================================================

# Database Configuration
DB_NAME=careerforge_prod
DB_USERNAME=careerforge_app
DB_PASSWORD=replace_with_strong_database_password_min_32_chars
DB_ROOT_PASSWORD=replace_with_strong_mysql_root_password_min_32_chars

# JWT Security Secrets (Generate via: openssl rand -base64 64)
JWT_SECRET=replace_with_512_bit_base64_encoded_hmac_secret_key_minimum_64_bytes
JWT_EXPIRATION_MS=900000          # 15 minutes in milliseconds
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 days in milliseconds

# CORS & Domain Configuration
CORS_ALLOWED_ORIGINS=https://careerforge.yourdomain.com

# Initial Production Administrator Bootstrapping (Used only on initial empty DB)
ADMIN_INIT_EMAIL=admin@yourdomain.com
ADMIN_INIT_PASSWORD=replace_with_secure_initial_admin_password
