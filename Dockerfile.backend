# =========================================================================
# Stage 1: Build Java Application using Maven & Temurin JDK 17
# =========================================================================
FROM maven:3.9.6-eclipse-temurin-17-alpine AS builder

WORKDIR /build

# Cache Maven dependencies
COPY pom.xml .
RUN mvn dependency:go-offline -B

# Copy source code and build executable JAR
COPY src ./src
RUN mvn clean package -DskipTests -B

# =========================================================================
# Stage 2: Minimal Production JRE Runtime
# =========================================================================
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# Create unprivileged application user
RUN addgroup -g 1001 -S careerforge && \
    adduser -u 1001 -S careerforge -G careerforge

# Create directory for persistent resume uploads
RUN mkdir -p /app/uploads/resumes && \
    chown -R careerforge:careerforge /app

# Copy compiled JAR from builder stage
COPY --from=builder --chown=careerforge:careerforge /build/target/careerforge-backend-*.jar /app/app.jar

USER careerforge:careerforge

EXPOSE 8080

ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError"

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/api/v1/health || exit 1

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
